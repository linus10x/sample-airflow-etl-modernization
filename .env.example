# Demo values only. Nothing here is a real credential; the stack runs on localhost.
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=warehouse
POSTGRES_PORT=5433

MINIO_ROOT_USER=demo-minio-user
MINIO_ROOT_PASSWORD=demo-minio-pass
S3_BUCKET=vendor-drops

# Airflow UI login for the local demo (http://localhost:8080)
AIRFLOW_UI_USER=admin
AIRFLOW_UI_PASSWORD=admin

# Optional: set to an incoming-webhook URL to also alert Slack. Leave empty for console only.
SLACK_WEBHOOK_URL=
